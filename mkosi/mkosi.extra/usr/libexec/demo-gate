#!/bin/sh
# SPDX-License-Identifier: LGPL-2.1-or-later
# Local checks only: things this host controls and can't run without.
set -e
ip -4 -o addr show scope global | grep -q inet || { echo "gate: no global IPv4 address"; exit 1; }
systemctl -q is-active sshd.service || { echo "gate: sshd is not running"; exit 1; }
echo "gate: passed"
