#!/bin/sh
# SPDX-License-Identifier: LGPL-2.1-or-later
# bootc-install VERSION: install that version on a fresh disk, as `bootc install to-disk` does,
# into .state/bootc-vm/disk.raw. Boot it with scripts/bootc-vm-start.
set -eu
. "$(dirname "$0")/lib.sh"
[ $# -eq 1 ] || { echo "usage: $0 VERSION" >&2; exit 2; }
ip=$(workbench_ip); [ -n "$ip" ] || { echo "no workbench running (scripts/bootc-workbench)" >&2; exit 1; }
# shellcheck disable=SC2086,SC2029
ssh $SSH_OPTS "root@$ip" bootc-install-image "$1" "$ip:5000"
mkdir -p "$STATE/bootc-vm"
mv "$STATE/out/bootc-disk.raw" "$STATE/bootc-vm/disk.raw"
rm -f "$STATE/bootc-vm/vars.fd" "$STATE/bootc-vm/console.log"   # fresh firmware variables too
