#!/bin/sh
# SPDX-License-Identifier: LGPL-2.1-or-later
# bootc-gce-image VERSION: install the published bootc image at VERSION (ghcr.io, from the
# bootc image workflow) on a 10G disk, and turn it into a GCE image named bootc-demo-VERSION.
# The host tracks ghcr.io's :latest. Root's authorized_keys is .state/keys/id_ed25519.pub,
# written at install: GCE has no SMBIOS credentials, and the image runs no guest agent.
set -eu
. "$(dirname "$0")/lib.sh"
. "$(dirname "$0")/gce-env"
v=${1:?usage: bootc-gce-image VERSION}
reg=${BOOTC_REGISTRY:-ghcr.io/fcuny/os-images}
ip=$(workbench_ip); [ -n "$ip" ] || { echo "no workbench running (scripts/bootc-workbench)" >&2; exit 1; }
# GCE imports a file named disk.raw, a whole number of GiB, in a tar.gz that GNU tar wrote.
# shellcheck disable=SC2086,SC2029
ssh $SSH_OPTS "root@$ip" "set -e; bootc-install-image $v $reg /keys/id_ed25519.pub
    d=\$(mktemp -d /var/tmp/gce.XXXX); mv /out/bootc-disk.raw \$d/disk.raw
    tar --format=oldgnu -Sczf /out/bootc-demo-$v.gce.tar.gz -C \$d disk.raw; rm -rf \$d"
gcloud storage cp "$STATE/out/bootc-demo-$v.gce.tar.gz" "gs://$GCE_BUCKET/images/" --project "$GCE_PROJECT"
gcloud compute images create "bootc-demo-$v" --project "$GCE_PROJECT" \
    --source-uri "gs://$GCE_BUCKET/images/bootc-demo-$v.gce.tar.gz" \
    --architecture ARM64 --guest-os-features UEFI_COMPATIBLE,GVNIC \
    --storage-location "$GCE_REGION"
