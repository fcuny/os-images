#!/bin/sh
# Boot .state/vm/disk.raw on the Mac with qemu and Apple's hypervisor (UEFI, virtio disk and network).
# Console goes to .state/vm/console.log, SSH is forwarded to 127.0.0.1:2222. Runs in the foreground.
# EXTRA_CMDLINE adds kernel arguments, passed to systemd-stub over SMBIOS (e.g. systemd.volatile=yes).
set -eu
. "$(dirname "$0")/lib.sh"
ensure_key
VM=$STATE/vm
Q=${QEMU_SHARE:-$(brew --prefix qemu)/share/qemu}
[ -f "$VM/vars.fd" ] || cp "$Q/edk2-arm-vars.fd" "$VM/vars.fd"
key=$(base64 < "$KEY.pub" | tr -d '\n')
set --
[ -z "${EXTRA_CMDLINE:-}" ] || set -- -smbios "type=11,value=io.systemd.stub.kernel-cmdline-extra=$EXTRA_CMDLINE"
exec qemu-system-aarch64 -M virt -accel hvf -cpu host -smp 4 -m 2048 \
    -drive if=pflash,format=raw,readonly=on,file="$Q/edk2-aarch64-code.fd" \
    -drive if=pflash,format=raw,file="$VM/vars.fd" \
    -drive if=none,id=hd,file="$VM/disk.raw",format=raw -device virtio-blk-pci,drive=hd \
    -nic user,model=virtio-net-pci,hostfwd=tcp:127.0.0.1:2222-:22 \
    -device virtio-rng-pci -device i6300esb \
    -smbios "type=11,value=io.systemd.credential.binary:ssh.authorized_keys.root=$key" \
    -smbios "type=11,value=io.systemd.credential:passwd.plaintext-password.root=demo" \
    -display none -serial file:"$VM/console.log" -pidfile "$VM/qemu.pid" "$@"
